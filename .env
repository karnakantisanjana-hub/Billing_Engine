# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DATABASE_URL=postgresql://postgres:123@localhost:5432/billing_db

# ==========================================
# ADMIN JWT CONFIGURATION (Existing)
# ==========================================
JWT_SECRET_KEY=super-secure-shared-development-secret-key-123
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ==========================================
# CUSTOMER PORTAL JWT CONFIGURATION (New)
# ==========================================
# 🌟 Make this match the JWT_SECRET_KEY above!
SECRET_KEY=super-secure-shared-development-secret-key-123
ALGORITHM=HS256
CUSTOMER_ACCESS_TOKEN_EXPIRE_MINUTES=480    
CUSTOMER_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# CORS CONFIGURATION
# ==========================================

FRONTEND_URLS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:5500

# ==========================================
# SERVER CONFIGURATION
# ==========================================
HOST=0.0.0.0
PORT=8000
RELOAD=True
ENVIRONMENT=developmenttree